# =============================================================================
# .env.example — Hospital Management System
# Complete environment variable reference
#
# Usage:
#   cp .env.example .env
#   # Edit .env and fill in all REQUIRED values
#   docker compose up
#
# IMPORTANT:
#   - Never commit the real .env file to source control (.env is in .gitignore)
#   - This .env.example file MUST be committed — it documents all variables
#   - When running via Docker Compose, SPRING_PROFILES_ACTIVE=prod is set
#     automatically in docker-compose.yml (no need to set it here)
#   - The prod profile has NO fallback defaults for secrets — missing required
#     variables cause an immediate startup failure (fail-fast by design)
#
# Variable categories:
#   [REQUIRED] — App will NOT start without these
#   [OPTIONAL] — Safe defaults exist; feature is silently disabled if absent
#   [DEV ONLY] — Only meaningful when running outside Docker (profile=dev)
# =============================================================================


# ── Database ──────────────────────────────────────────────────────────────────
# [REQUIRED] PostgreSQL login credentials.
# Docker Compose constructs DB_URL automatically (postgres service name).
# Override DB_URL only when pointing to an external PostgreSQL instance.
#
# DB_URL=jdbc:postgresql://postgres:5432/hospital_db
DB_USERNAME=postgres
DB_PASSWORD=change_this_strong_db_password


# ── JWT ───────────────────────────────────────────────────────────────────────
# [REQUIRED] HMAC-SHA256 signing key.
# Must be at least 32 characters (256 bits).
# Generate a safe value with:  openssl rand -base64 64
JWT_SECRET=replace_with_cryptographically_random_secret_min_32_chars


# ── Admin Account ─────────────────────────────────────────────────────────────
# [REQUIRED] Initial password for the admin@hospital.com account seeded on
# first startup. Change this password immediately after the first login.
# Stored as BCrypt hash — the plaintext value is never persisted.
ADMIN_DEFAULT_PASSWORD=Change_This_Immediately!


# ── WebSocket Allowed Origins ─────────────────────────────────────────────────
# [REQUIRED] Comma-separated list of frontend origins permitted to connect
# via WebSocket (STOMP). Must match your deployed frontend URL(s).
# Example: https://app.hospital.com,https://www.hospital.com
WEBSOCKET_ALLOWED_ORIGINS=https://app.hospital.com


# ── Email / SMTP ──────────────────────────────────────────────────────────────
# [OPTIONAL] Gmail SMTP credentials for outgoing mail (password reset, etc.).
# Leave both values blank (empty string) to disable mail features entirely.
# The application starts normally without these — mail calls will simply fail.
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password


# ── Redis ─────────────────────────────────────────────────────────────────────
# [OPTIONAL] Redis connection settings.
# Defaults to the Docker service name 'redis' on port 6379.
# Override only when using an external or managed Redis instance.
# REDIS_HOST=redis
# REDIS_PORT=6379


# ── Development helpers ────────────────────────────────────────────────────────
# [DEV ONLY] The variables below are only relevant when running locally
# without Docker Compose (i.e., SPRING_PROFILES_ACTIVE=dev).
# They have NO effect when Docker Compose sets SPRING_PROFILES_ACTIVE=prod.

# Override the local DB URL (default: jdbc:postgresql://localhost:5433/hospital_db)
# DB_URL=jdbc:postgresql://localhost:5433/hospital_db

# Override the local Redis host (default: localhost)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Show SQL in the console (dev profile enables this by default; prod ignores it)
# SHOW_SQL=true
