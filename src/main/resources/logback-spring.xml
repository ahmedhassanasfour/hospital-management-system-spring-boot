<?xml version="1.0" encoding="UTF-8"?>
<!--
  logback-spring.xml — Profile-aware logging configuration
  Spring Boot reads this file instead of logback.xml, enabling <springProfile> tags.
-->
<configuration>

    <!-- ── Shared appenders ──────────────────────────────────────────────── -->

    <!--
      CONSOLE appender (used by both profiles).
      Uses Spring Boot's default pattern so log colours work in IDEs and terminals.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ── Development profile ───────────────────────────────────────────── -->
    <!--
      Verbose logging for local development.
      SQL, security events, and application debug messages are all visible.
    -->
    <springProfile name="dev">

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- Application code: DEBUG for full visibility -->
        <logger name="com.ahmed.hospital" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- Spring Security: DEBUG to see filter decisions during development -->
        <logger name="org.springframework.security" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- Hibernate SQL: DEBUG so generated queries are shown -->
        <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- Hibernate bind parameters (TRACE) — disable if too noisy -->
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

    </springProfile>

    <!-- ── Production profile ────────────────────────────────────────────── -->
    <!--
      Minimal, safe production logging.
      - No SQL output (prevents data leakage)
      - No DEBUG / TRACE
      - Application INFO events are retained for operational monitoring
      - Security WARN events surface authentication and authorisation problems
      - Root WARN keeps third-party noise out of logs
    -->
    <springProfile name="prod">

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>

        <!-- Application code: INFO — startup, business events, errors -->
        <logger name="com.ahmed.hospital" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- Spring Security: WARN — only auth failures and config issues -->
        <logger name="org.springframework.security" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- Actuator: WARN — suppress periodic health-check noise -->
        <logger name="org.springframework.boot.actuate" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- Hibernate: WARN — surface schema problems only; no SQL logging -->
        <logger name="org.hibernate" level="WARN" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

        <!-- HikariCP: INFO — pool lifecycle events are useful in production -->
        <logger name="com.zaxxer.hikari" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>

    </springProfile>

</configuration>
